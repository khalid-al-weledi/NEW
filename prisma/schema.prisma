
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  ACADEMIC_SUPERVISOR
  TEACHER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum RegistrationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  AWAITING_INFORMATION
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerType {
  WELCOME_GIFT
  PURCHASE
  SESSION_DEDUCTION
  REFUND
  ADMIN_ADJUSTMENT
  LOAN
  LOAN_REPAYMENT
}

enum VideoStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         UserRole @default(STUDENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student       Student?
  registrations Registration[] @relation("Applicant")
  reviewedPayments Payment[]   @relation("PaymentReviewer")
  videos        Video[]        @relation("VideoPublisher")
}

model Student {
  id            String   @id @default(cuid())
  studentCode   String   @unique
  userId        String   @unique
  gender        Gender
  age           Int?
  country       String?
  city          String?
  guardianPhone String?
  balanceMinutes Int    @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  registrations Registration[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
}

model Program {
  id          String   @id @default(cuid())
  nameAr      String
  nameEn      String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  registrations Registration[]
}

model Registration {
  id                 String             @id @default(cuid())
  applicationNumber  String             @unique
  applicantUserId    String?
  studentId          String?
  programId          String
  fullName           String
  gender             Gender
  age                Int?
  country            String
  city               String?
  phone              String
  previousTeacher    String?
  previousSchool     String?
  learningDuration   String?
  readingLevel       String?
  studiedTajweed     Boolean            @default(false)
  previousIjazat     String?
  previousRiwayat    String?
  readQuranLooking   Boolean            @default(false)
  memorizationStatus String?
  preferredTeacher   String?
  preferredDays      String?
  preferredPeriod    String?
  notes              String?
  status             RegistrationStatus @default(PENDING)
  reviewNote         String?
  reviewedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  applicant User?   @relation("Applicant", fields: [applicantUserId], references: [id])
  student   Student? @relation(fields: [studentId], references: [id])
  program   Program  @relation(fields: [programId], references: [id])

  @@index([status, createdAt])
  @@index([phone])
}

model Package {
  id            String   @id @default(cuid())
  name          String
  minutes       Int
  priceEtb      Int
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id              String        @id @default(cuid())
  studentId       String
  packageId       String
  amountEtb       Int
  minutes         Int
  method          String
  receiptUrl      String?
  status          PaymentStatus @default(PENDING)
  reviewNote      String?
  reviewedById    String?
  reviewedAt      DateTime?
  idempotencyKey  String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  student   Student @relation(fields: [studentId], references: [id])
  package   Package @relation(fields: [packageId], references: [id])
  reviewer  User?   @relation("PaymentReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([studentId, createdAt])
}

model LedgerEntry {
  id             String     @id @default(cuid())
  studentId      String
  type           LedgerType
  minutesDelta   Int
  balanceBefore  Int
  balanceAfter   Int
  reason         String
  referenceId    String?
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
}

model Video {
  id            String      @id @default(cuid())
  title         String
  description   String?
  videoUrl      String
  thumbnailUrl  String?
  reciterName   String?
  riwayah       String?
  category      String?
  status        VideoStatus @default(DRAFT)
  views         Int         @default(0)
  publishedAt   DateTime?
  publisherId   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  publisher User? @relation("VideoPublisher", fields: [publisherId], references: [id])

  @@index([status, publishedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
